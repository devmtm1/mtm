# ============================================================
# MTM Immobilier — Variables d'environnement (exemple)
# Copier ce fichier en .env (dev), .env.test ou .env.production
# NE JAMAIS committer un fichier .env réel (voir .gitignore)
# ============================================================

# --- Environnement ---
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=mtm_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=mtm_immobilier
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL complète utilisée par Prisma
DATABASE_URL="postgresql://mtm_user:change_me_in_local_env@postgres:5432/mtm_immobilier?schema=public"

# --- Seed administrateur ---
# Obligatoire pour exécuter le seed ; 12 caractères minimum.
SEED_ADMIN_EMAIL=admin@mtm-immobilier.sn
SEED_ADMIN_PASSWORD=change_me_admin_password

# --- API (NestJS) ---
API_PORT=3000
API_HOST=0.0.0.0

# --- JWT / Auth ---
# Générer des secrets forts en production (ex: openssl rand -base64 64)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Sécurité ---
BCRYPT_SALT_ROUNDS=12
LOGIN_RATE_LIMIT_TTL=60
LOGIN_RATE_LIMIT_MAX=5
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# --- Anti-abus des formulaires publics du site vitrine ---
# Le throttle global (100 req/min/IP, voir ThrottlerModule dans app.module.ts)
# s'applique à toute l'API. Ces formulaires publics à fort enjeu (leads
# commerciaux) ont en plus une limite dédiée, plus stricte.
CONTACT_RATE_LIMIT_TTL=60
CONTACT_RATE_LIMIT_MAX=5
RESERVATION_RATE_LIMIT_TTL=60
RESERVATION_RATE_LIMIT_MAX=5

# --- 2FA ---
TWO_FACTOR_APP_NAME="MTM Immobilier"

# --- CORS ---
# Lister ICI toutes les origines autorisées à appeler l'API : back-office
# ET site public (public-web), séparées par des virgules. En développement,
# http://localhost:5173 (site public, Vite) et :4200 (back-office, Angular)
# sont déjà autorisés automatiquement par main.ts — cette variable ne doit
# être complétée qu'avec les domaines réels de PRODUCTION des deux sites
# avant mise en ligne (ex: https://www.mtm-immobilier.sn,https://admin.mtm-immobilier.sn).
CORS_ORIGIN=http://localhost:4200,http://localhost:5173

# --- Cloudinary (stockage médias et documents) ---
# Laisser vide en développement local si le stockage local est utilisé.
# CLOUDINARY_CLOUD_NAME=change_me_cloudinary_cloud_name
# CLOUDINARY_API_KEY=change_me_cloudinary_api_key
# CLOUDINARY_API_SECRET=change_me_cloudinary_api_secret

# --- E-mails transactionnels (SMTP générique : Brevo, Resend, Mailgun, Google Workspace…) ---
# Sans SMTP_HOST : en développement les e-mails sont journalisés dans la console ;
# en production, /api/health passe en erreur (mail=down) car la réinitialisation
# de mot de passe, l'invitation espace client et les notifications de demandes
# ne peuvent pas partir.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=change_me
# SMTP_PASS=change_me
# MAIL_FROM="MTM Immobilier <no-reply@mtm-immobilier.sn>"
# Adresse interne qui reçoit les demandes de contact et de réservation du site
# public. À défaut, le bloc de contenu « contact.email » du back-office est utilisé.
# CONTACT_NOTIFY_EMAIL=contact@mtm-immobilier.sn
# URLs publiques des interfaces, pour les liens dans les e-mails.
PUBLIC_WEB_URL=http://localhost:5173
BACKOFFICE_URL=http://localhost:4200

# --- Back-office (Angular) ---
BACKOFFICE_PORT=4200
BACKOFFICE_API_URL=http://localhost:3000/api

# --- Sauvegardes ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# --- Rétention des journaux ---
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_INTERVAL_SECONDS=86400

# --- Rétention des documents (GED) ---
# Désactivée par défaut : les documents (titres, contrats, quittances...)
# ont une valeur légale/probatoire et ne doivent PAS être supprimés
# automatiquement sans validation explicite de MTM (et d'un conseil
# juridique si nécessaire — section 27 et 28 du cahier des charges).
# Pour activer, définir une durée ET la liste des types de documents
# autorisés à la purge automatique (voir docs/BACKUP.md).
# DOCUMENT_RETENTION_DAYS=3650
# DOCUMENT_RETENTION_PURGEABLE_TYPES=DocumentVente:justificatif,MandatDocument:correspondance
DOCUMENT_RETENTION_INTERVAL_SECONDS=86400
