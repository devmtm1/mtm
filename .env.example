# ============================================================
# MTM Immobilier — Variables d'environnement (exemple)
# Copier ce fichier en .env (dev), .env.test ou .env.production
# NE JAMAIS committer un fichier .env réel (voir .gitignore)
# ============================================================

# --- Environnement ---
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=mtm_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=mtm_immobilier
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL complète utilisée par Prisma
DATABASE_URL="postgresql://mtm_user:change_me_in_local_env@postgres:5432/mtm_immobilier?schema=public"

# --- API (NestJS) ---
API_PORT=3000
API_HOST=0.0.0.0

# --- JWT / Auth ---
# Générer des secrets forts en production (ex: openssl rand -base64 64)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Sécurité ---
BCRYPT_SALT_ROUNDS=12
LOGIN_RATE_LIMIT_TTL=60
LOGIN_RATE_LIMIT_MAX=5
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# --- 2FA ---
TWO_FACTOR_APP_NAME="MTM Immobilier"

# --- CORS ---
CORS_ORIGIN=http://localhost:4200

# --- Back-office (Angular) ---
BACKOFFICE_PORT=4200
BACKOFFICE_API_URL=http://localhost:3000/api

# --- Sauvegardes ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
