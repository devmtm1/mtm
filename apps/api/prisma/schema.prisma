// MTM Immobilier — Schéma Prisma
// Phase 0 : socle technique (identité, RBAC, audit, paramétrage).
// Phase 1 / J1.1-J1.4 : tables métier terrains et mandats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identité & authentification
// ============================================================

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // hash bcrypt, jamais en clair

  firstName String
  lastName  String

  isActive Boolean @default(true) // comptes actifs/inactifs (section 24/27 CDC)

  // Force le changement de mot de passe à la prochaine connexion —
  // activé par défaut sur les comptes créés par un admin (mot de passe
  // provisoire) et sur le compte admin seedé.
  mustChangePassword Boolean @default(false)

  // --- Sécurité / brute-force ---
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? // verrouillage temporaire après N échecs

  // --- 2FA (TOTP) ---
  twoFactorEnabled       Boolean @default(false)
  twoFactorSecret        String? // chiffré côté application avant stockage
  twoFactorRecoveryCodes String? // codes de secours chiffrés (JSON)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles            UserRole[]
  refreshTokens    RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs        AuditLog[]      @relation("AuditLogUser")
   settingsEdits    SystemSetting[] @relation("SystemSettingEditor")
   contentEdits     ContentBlock[]  @relation("ContentBlockEditor")
   assignedTerrains Terrain[]       @relation("TerrainCommercial")
  mandatsResponsable Mandat[]     @relation("MandatCommercial")
  prospectsCommercial  Prospect[] @relation("ProspectCommercial")

  @@map("users")
}

// ============================================================
// Terrains — Phase 1 / J1.1
// ============================================================

model Proprietaire {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terrains Terrain[]
  mandats Mandat[]

  @@index([lastName, firstName])
  @@map("proprietaires")
}

model Terrain {
  id                      String            @id @default(uuid())
  referenceInterne        String            @unique
  nom                     String
  parcelleMatricule       String?
  informationsCadastrales Json?
  proprietaireId          String?
  proprietaire            Proprietaire?     @relation(fields: [proprietaireId], references: [id], onDelete: SetNull)
  statutJuridique         String
  typeDocumentFoncier     String?
  niveauVerification      String
  region                  String?
  commune                 String?
  localisationDetail      String?
  latitude                Decimal?          @db.Decimal(10, 7)
  longitude               Decimal?          @db.Decimal(10, 7)
  superficie              Decimal?          @db.Decimal(14, 2)
  uniteSuperficie         String?
  dimensions              Json?
  prixAcquisition         Decimal?          @db.Decimal(15, 2)
  prixPublic              Decimal?          @db.Decimal(15, 2)
  marge                   Decimal?          @db.Decimal(15, 2)
  commission              Decimal?          @db.Decimal(15, 2)
   statutCommercial        String
  misEnAvant              Boolean           @default(false)
  accesRoutier            String?
  eauDisponible           Boolean?
  electriciteDisponible   Boolean?
  voisinage               String?
  vocation                String?
  proximiteAxes           String?
   pointsInteret           Json?
   notesInternes           String?
   contacts                Contact[]     @relation("TerrainContacts")
  commercialResponsableId String?
  commercialResponsable   User?             @relation("TerrainCommercial", fields: [commercialResponsableId], references: [id], onDelete: SetNull)
  medias                  TerrainMedia[]
  documents               TerrainDocument[]
  mandatLots              MandatLot[]
  dossiers                DossierVente[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([statutJuridique])
  @@index([niveauVerification])
  @@index([statutCommercial])
  @@index([proprietaireId])
  @@index([commercialResponsableId])
  @@index([region, commune])
  @@index([superficie])
  @@index([prixPublic])
  @@map("terrains")
}

model TerrainMedia {
  id         String    @id @default(uuid())
  terrainId  String
  terrain    Terrain   @relation(fields: [terrainId], references: [id], onDelete: Cascade)
  type       String
  storageKey String
  resourceType String @default("image")
  title      String?
  isPublic   Boolean   @default(false)
  sortOrder  Int       @default(0)
  capturedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([terrainId, sortOrder])
  @@map("terrain_medias")
}

model TerrainDocument {
  id         String   @id @default(uuid())
  terrainId  String
  terrain    Terrain  @relation(fields: [terrainId], references: [id], onDelete: Cascade)
  type       String
  storageKey String
  resourceType String @default("raw")
  title      String?
  isPublic  Boolean  @default(false)
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([terrainId, type])
  @@map("terrain_documents")
}

// ============================================================
// Mandats de commercialisation — Phase 1 / J1.4
// ============================================================

model Mandat {
  id                      String   @id @default(uuid())
  proprietaireId          String
  proprietaire            Proprietaire @relation(fields: [proprietaireId], references: [id], onDelete: Restrict)
  commercialResponsableId String?
  commercialResponsable   User?     @relation("MandatCommercial", fields: [commercialResponsableId], references: [id], onDelete: SetNull)

  referenceInterne        String   @unique
  typeMandat              String
  dateDebut               DateTime
  dateFin                 DateTime
  exclusivite             Boolean  @default(false)
  prixConditions          String?
  commissions             String?
  clauses                 String?
  restrictionsContractuelles Json?
  objectifsCommercialisation String?
  alerteEcheanceJours     Int?     @default(30)
  statut                  String   @default("Brouillon")

  lots                    MandatLot[]
  documents               MandatDocument[]
  dossiers                DossierVente[]
  auditLogs               AuditLog[] @relation("MandatAuditLog")

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([proprietaireId])
  @@index([commercialResponsableId])
  @@index([statut])
  @@index([dateFin])
  @@map("mandats")
}

model MandatLot {
  id         String   @id @default(uuid())
  mandatId   String
  mandat     Mandat   @relation(fields: [mandatId], references: [id], onDelete: Cascade)
  terrainId  String
  terrain    Terrain  @relation(fields: [terrainId], references: [id], onDelete: Restrict)

  statutLot  String   @default("Confie")
  dateAttribution DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([mandatId])
  @@index([terrainId])
  @@index([statutLot])
  @@map("mandat_lots")
}

model MandatDocument {
  id          String   @id @default(uuid())
  mandatId    String
  mandat      Mandat   @relation(fields: [mandatId], references: [id], onDelete: Cascade)
  type        String
  storageKey  String
  resourceType String @default("raw")
  title       String?
  isPublic    Boolean @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([mandatId, type])
  @@map("mandat_documents")
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique // le token brut n'est jamais stocké
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime? // révocation explicite (logout, rotation, compromission)

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================
// RBAC — Rôles & permissions génériques
// ============================================================
// Modèle volontairement générique (resource:action) pour être réutilisable
// par les futurs modules métier sans refactorisation (exigence CDC section 24).

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // ex: "administrateur", "commercial", "comptable"
  description String?
  isSystem    Boolean @default(false) // rôle non supprimable (ex: administrateur)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  // Convention "resource:action", actions alignées sur la section 24 du CDC :
  // consulter, creer, modifier, valider, supprimer, exporter, payer, publier, administrer
  name        String  @unique
  resource    String // ex: "users", "settings", "audit" — extensible aux modules métier futurs
  action      String // ex: "consulter", "creer", "modifier"...
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// Audit — journal générique et réutilisable (section 24 CDC)
// ============================================================

model AuditLog {
  id     String  @id @default(uuid())
  userId String? // nullable : actions système sans utilisateur identifié
  user   User?   @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  action     String // ex: "user.created", "role.assigned", "settings.updated"
  entityType String // ex: "User", "Role", "SystemSetting" — générique pour futurs modules
  entityId   String?

  oldValue Json?
  newValue Json?
  justification String?

  ipAddress String?
  userAgent String?
  mandatId  String?
  mandat    Mandat? @relation("MandatAuditLog", fields: [mandatId], references: [id], onDelete: SetNull)
  prospectId String?
  prospect   Prospect? @relation("ProspectAuditLog", fields: [prospectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([mandatId])
  @@index([prospectId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Paramétrage général (section 25 CDC)
// ============================================================

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value Json

  description String?
  isSensitive Boolean @default(false) // permissions renforcées si true (section 25)

  updatedById String?
  updatedBy   User?    @relation("SystemSettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_settings")
}

// ============================================================
// Contact public (J1.2)
// ============================================================

model Contact {
  id        String    @id @default(uuid())
  terrainId String?   // terrain de référence si la demande provient d'une fiche
   terrain   Terrain?  @relation("TerrainContacts", fields: [terrainId], references: [id], onDelete: SetNull)
  nom       String
  email     String
  telephone String?
  sujet     String?   // "Acquérir un terrain" / "Vérification foncière" / "Gestion locative" / ...
  message   String
  lu        Boolean   @default(false)
  createdAt DateTime  @default(now())

   @@index([terrainId])
   @@index([lu])
    @@index([createdAt])
   @@map("contacts")
}

// ============================================================
// CRM — prospects et clients (Phase 1 / J1.5)
// ============================================================

model Prospect {
  id                     String   @id @default(uuid())
  nom                    String
  prenom                 String?
  email                  String?
  telephone              String?
  paysResidence          String?
  sourceAcquisition      String?
  besoins                String?
  budgetMin              Decimal? @db.Decimal(15, 2)
  budgetMax              Decimal? @db.Decimal(15, 2)
  preferences            String?
  commercialResponsableId String?
  commercialResponsable   User?    @relation("ProspectCommercial", fields: [commercialResponsableId], references: [id], onDelete: SetNull)
  statutPipeline         String   @default("nouveau_contact")
  score                  Int?     @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  activites              ActiviteCrm[]
  documents              DocumentCrm[]
  dossiers               DossierVente[]
  auditLogs              AuditLog[] @relation("ProspectAuditLog")

  @@index([commercialResponsableId])
  @@index([statutPipeline])
  @@index([createdAt])
  @@map("prospects")
}

model DossierVente {
  id          String   @id @default(uuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  terrainId   String?
  terrain     Terrain? @relation(fields: [terrainId], references: [id], onDelete: SetNull)
  mandatId    String?
  mandat      Mandat?  @relation(fields: [mandatId], references: [id], onDelete: SetNull)
  statut      String   @default("en_cours")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([prospectId])
  @@index([terrainId])
  @@index([mandatId])
  @@map("dossiers_vente")
}

model ActiviteCrm {
  id          String   @id @default(uuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type        String   // appel, rendez-vous, tache, relance, email, note
  titre       String
  description String?
  dateEcheance DateTime?
  dateRealisation DateTime?
  statut      String   @default("a_faire") // a_faire, realise, reporte, annule
  priorite   String   @default("moyenne") // basse, moyenne, haute
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([prospectId])
  @@index([statut])
  @@map("activites_crm")
}

model DocumentCrm {
  id          String   @id @default(uuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type        String
  storageKey  String
  resourceType String @default("raw")
  title       String?
  isPublic    Boolean  @default(false)
  url         String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([prospectId, type])
  @@map("documents_crm")
}

// ============================================================
// Contenus marketing administrables (J1.2)
// ============================================================

model ContentBlock {
  id        String    @id @default(uuid())
  key       String    @unique // ex: "home.hero.title", "about.text", "testimonial.1"
  title     String?   // titre éditorial (optionnel)
  content   String     // contenu markdown ou texte
  type      String     @default("text") // "text" | "hero" | "testimonial" | "stat"
  ordre     Int        @default(0) // ordre d'affichage
  isActive  Boolean    @default(true)
  updatedById String?
  updatedBy   User?     @relation("ContentBlockEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([isActive])
  @@index([ordre])
  @@map("content_blocks")
}
