# Dockerfile de développement — Back-office Angular
# Utilisé par docker-compose.yml (service "backoffice")
# Devient pleinement fonctionnel une fois le projet Angular scaffoldé (étape 10)

FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
COPY apps/backoffice/package.json ./apps/backoffice/package.json

RUN npm install --workspace=apps/backoffice

COPY apps/backoffice ./apps/backoffice

WORKDIR /app/apps/backoffice

EXPOSE 4200

CMD ["npm", "run", "start", "--", "--host", "0.0.0.0"]
